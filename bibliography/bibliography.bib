}

@article{chandrappaLevelsetFormulationSimulate2023a,
  title = {A Level-Set Formulation to Simulate Diffusive Solid/Solid Phase Transformation in Polycrystalline Metallic Materials - {{Application}} to Austenite Decomposition in Steels},
  author = {Chandrappa, N. and Bernacki, M.},
  date = {2023-01-05},
  journaltitle = {Computational Materials Science},
  shortjournal = {Comput. Mater. Sci.},
  volume = {216},
  pages = {111840},
  issn = {0927-0256},
  doi = {10.1016/j.commatsci.2022.111840},
  url = {https://www.sciencedirect.com/science/article/pii/S0927025622005511},
  urldate = {2024-11-05},
  abstract = {Numerous full-field numerical methods exist concerning the digital description of polycrystalline materials and the modeling of their evolution during thermomechanical treatments. However, these strategies are globally dedicated to the modeling of recrystallization and grain growth for single-phase materials, or to the modeling of phase transformations without considering recrystallization and related phenomena. A generalized numerical framework capable of making predictions in a multi-phase polycrystalline context while respecting the concomitance of the different microstructural mechanisms is thus of prime interest. A novel finite element level-set based full-field numerical formulation is proposed to principally simulate diffusive solid–solid phase transformation at the mesoscopic scale in the context of two-phase metallic alloys. A global kinetic framework, capable of accounting for other concomitant mechanisms such as recrystallization and grain growth is considered in this numerical model. The proposed numerical framework is shown to be promising through a couple of illustrative 1D and 2D test cases in the context of austenite decomposition in steels and compared with ThermoCalc estimations.},
  keywords = {_FINISHED,Austenite decomposition,Diffusive phase transformation,Full-field method,Level-set,Microstructural evolution},
  file = {/home/admin-bliu/Zotero/storage/XWVLL2CA/Chandrappa_Bernacki_2023_A level-set formulation to simulate diffusive solid-solid phase transformation.pdf}
}

