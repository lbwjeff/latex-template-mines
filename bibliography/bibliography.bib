@article{shiMicrostructureTransformationTexture2015,
  title = {Microstructure and Transformation Texture Evolution during Alpha Precipitation in Polycrystalline Alpha/Beta Titanium Alloys – {{A}} Simulation Study},
  author = {Shi, R. and Zhou, N. and Niezgoda, S.R. and Wang, Y.},
  date = {2015-08},
  journaltitle = {Acta Materialia},
  shortjournal = {Acta Mater.},
  volume = {94},
  pages = {224--243},
  issn = {13596454},
  doi = {10.1016/j.actamat.2015.04.050},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S135964541500302X},
  urldate = {2025-03-31},
  abstract = {A three-dimensional phase field model of b ! a transformation in polycrystalline Ti–6Al–4V (wt.\%) alloys is formulated and used to study variant selection and microstructure evolution under different processing conditions and starting b phase textures. Degrees of variant selection at both individual b grain and polycrystalline b volume element levels and their connections to the final micro- and macro-texture of a precipitates are analyzed and correlated with the processing parameters. It is found that local stresses in an elastically anisotropic and inhomogeneous polycrystalline volume element lead to obvious variant selection. Under certain pre-strains, a local volume element of a polycrystalline b sample considered in the simulations could end up with a relatively weak micro- and macro-texture of the transformed a phase if it has a strong starting b phase texture. Moreover, a Fix-End (clamped) boundary constraint to the volume element is found to be more favorable than a Free-End (relaxed) one in preventing the formation of strong transformation texture irrespective of the strength of the starting b phase texture. Other factors contributing to variant selection and transformation texture development are also discussed. The results could shed light on how to control processing conditions and internal stresses to reduce transformation texture at both the individual b grain and the polycrystalline volume element level.},
  langid = {english},
  keywords = {_TOREAD},
  file = {/home/admin-bliu/Zotero/storage/GNH3NQ46/Shi et al. - 2015 - Microstructure and transformation texture evolution during alpha precipitation in polycrystalline al.pdf}
}

@article{shiVariantSelectionPrecipitation2013,
  title = {Variant Selection during Alpha Precipitation in {{Ti}}–{{6Al}}–{{4V}} under the Influence of Local Stress – {{A}} Simulation Study},
  author = {Shi, R. and Wang, Y.},
  date = {2013-09},
  journaltitle = {Acta Materialia},
  shortjournal = {Acta Mater.},
  volume = {61},
  number = {16},
  pages = {6006--6024},
  issn = {13596454},
  doi = {10.1016/j.actamat.2013.06.042},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S1359645413004758},
  urldate = {2025-03-28},
  abstract = {Variant selection of a (hexagonal close-packed, hcp) phase during its precipitation from b (body-centered cubic, bcc) matrix plays a key role in determining the microstructural state and mechanical properties of a/b titanium alloys. In this work, we develop a threedimensional quantitative phase field model to predict variant selection and microstructural evolution during b ! a transformation in Ti–6Al–4V (wt.\%) under the influence of both external and internal stresses. The model links its inputs directly to thermodynamic and mobility databases, and incorporates the crystallography of bcc to hcp transformation, elastic anisotropy and defects within semi-coherent a/b interfaces in its total free energy formulation. It is found that, for a given undercooling, the development of a transformation texture (also called microtexture) of the a phase due to variant selection during precipitation is determined by the interplay between externally applied stress or strain and internal stress generated by the precipitation reaction itself. For example, the growth of pre-existing a precipitates is accompanied by selective nucleation and growth of secondary a plates of certain variants that may not be the ones preferred by the initially applied stress. Possible measures to reduce transformation texture are discussed.},
  langid = {english},
  keywords = {_ONGOING},
  file = {/home/admin-bliu/Zotero/storage/WALYLG4S/Shi and Wang - 2013 - Variant selection during alpha precipitation in Ti–6Al–4V under the influence of local stress – A si.pdf}
}

